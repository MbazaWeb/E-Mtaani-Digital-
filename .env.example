# E-Mtaani Digital environment variables
# Copy to .env.local for local development. Keep real secrets out of Git.

# Browser-visible Supabase configuration (publishable/anon key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_DEMO_MODE=false
VITE_SITE_URL=http://localhost:5173
VITE_USE_LOCAL_SERVER=false
VITE_LOCAL_SERVER_URL=http://localhost:3001

# Public payment configuration only; live payments are not currently connected
VITE_PAYMENT_PROVIDER=mock
VITE_PAYMENT_PUBLIC_KEY=

# Optional client-side monitoring
VITE_SENTRY_DSN=

# Server-side only. Required by api/admin.ts; configure as Vercel server env vars.
# Never add the service-role key to a VITE_ variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
