# ── Public site URL (used for QR/verify links, redirects, assets) ──
VITE_SITE_URL=https://www.e-mtaatz.xyz

# ============================================================
# INTEGRATION ENVIRONMENT VARIABLES (example)
# Copy the needed lines into your .env / Vercel env vars.
# Everything defaults to OFF (demonstration mode).
# ============================================================

# ── Master switches ──────────────────────────────────────
VITE_ENABLE_NIDA=false
VITE_ENABLE_TRA=false
VITE_ENABLE_POLICE=false
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_SMS=false

# ── Endpoints / non-secret config (safe in client) ───────
VITE_NIDA_API_URL=
VITE_TRA_API_URL=
VITE_POLICE_API_URL=
VITE_PAYMENT_API_URL=
VITE_PAYMENT_PROVIDER=mock
VITE_SMS_PROVIDER=mock
VITE_SMS_SENDER_ID=E-MTAA

# ── Secrets — SERVER-SIDE ONLY (Supabase Edge Functions /
#    serverless routes). Never prefix these with VITE_. ────
# NIDA_API_KEY=
# TRA_API_KEY=
# POLICE_API_KEY=
# PAYMENT_MERCHANT_ID=
# PAYMENT_MERCHANT_SECRET=
# SMS_API_KEY=
