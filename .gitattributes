# Normalize line endings to LF across all platforms.
# Windows checkouts will keep LF instead of being converted to CRLF,
# which prevents the 94k+ prettier/prettier "Delete `␍`" errors.

# Default: treat all text files as text with LF endings.
* text=auto eol=lf

# Source code — always LF.
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.json5     text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.sass      text eol=lf
*.html      text eol=lf
*.htm       text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf

# Windows-only scripts keep CRLF (PowerShell + batch files are CRLF-native).
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary files — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.bmp       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.rar       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.webm      binary
*.wav       binary
*.ogg       binary
*.db        binary
*.sqlite    binary
*.apk       binary
*.aab       binary
*.keystore  binary
*.jks       binary
